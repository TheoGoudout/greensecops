# Pinned by digest, not just by tag: Microsoft republishes the noble tag as the
# base OS is patched, so the tag alone does not make the build reproducible.
FROM mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e

LABEL org.opencontainers.image.source="https://github.com/TheoGoudout/greensecops"
LABEL org.opencontainers.image.licenses="MIT"

WORKDIR /app

# Copied out of the official bun image rather than installed with
# `curl https://bun.sh/install | bash`. Piping a remote script into a shell
# executes whatever the host serves at build time, unverified; a digest-pinned
# COPY --from is immutable, and it also drops the `unzip` package that only the
# installer script needed. This mirrors how backend/Dockerfile obtains uv.
COPY --from=oven/bun:1@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 \
     /usr/local/bin/bun /usr/local/bin/bun

# `bunx` is the same binary under a second name — bun dispatches on argv[0] —
# and the CI suite invokes it directly (`docker compose run playwright bunx
# playwright test`). The installer script this replaced created both, so the
# link has to be recreated explicitly.
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx

COPY package.json bun.lock /app/

COPY frontend/package.json /app/frontend/

WORKDIR /app/frontend

RUN bun install

COPY ./frontend /app/frontend

ARG VITE_API_URL

RUN groupadd --system --gid 10001 appuser && \
    useradd --system --uid 10001 --gid appuser --shell /usr/sbin/nologin appuser && \
    chown -R appuser:appuser /app

USER appuser
