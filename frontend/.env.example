# API
VITE_API_URL=http://localhost:8000
# Public backend URL used for badge image/markdown links (empty → VITE_API_URL).
# Same value as root GREENSECOPS_PUBLIC_URL — useful when the backend is behind
# a dev tunnel (e.g. ngrok) so badges resolve from outside localhost.
VITE_GREENSECOPS_PUBLIC_URL=
MAILCATCHER_HOST=http://localhost:1080

# GitHub OAuth
VITE_GITHUB_APP_NAME=your-github-app-slug
# GitHub OAuth App Client ID (public). Same value as root GITHUB_CLIENT_ID.
# The OAuth App's "Authorization callback URL" must point to the frontend:
# http://localhost:5173/auth/github/callback
VITE_GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
