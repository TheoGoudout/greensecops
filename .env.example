# General
PROJECT_NAME="GreenSecOps"
# Environment: local, staging, production
ENVIRONMENT=local

# Hosts & URLs
FRONTEND_HOST=http://localhost:5173
BACKEND_HOST=http://localhost:8000
# Public backend URL embedded in generated customer workflows (empty → BACKEND_HOST).
# Also added to allowed CORS origins and used as the badge-image host when set —
# useful as a dev tunnel (e.g. ngrok) base URL so GitHub can reach a local backend.
GREENSECOPS_PUBLIC_URL=
# Marketing/landing site URL: embedded in PR body attribution links, and used
# by the landing page itself for legal-copy self-references.
MARKETING_URL=https://greensecops.com
DOCS_URL=http://localhost:3002
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173"

# Auth & Security
# generate: openssl rand -hex 32
SECRET_KEY=
# minutes; default 11520 = 8 days
ACCESS_TOKEN_EXPIRE_MINUTES=11520
FIRST_SUPERUSER=admin@example.com
# min 8 chars
FIRST_SUPERUSER_PASSWORD=
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48

# Database & Infrastructure
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=greensecops
POSTGRES_USER=postgres
# required
POSTGRES_PASSWORD=
REDIS_URL=redis://localhost:6379/0
OPA_URL=http://localhost:8181

# Object Storage (MinIO / S3-compatible) — large scan artifacts (Terraform
# file bundles, cloud resource snapshots) that don't belong in Postgres.
# Local dev defaults to minioadmin/minioadmin; staging/production must set
# explicit values.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=greensecops-artifacts
S3_REGION=us-east-1

# Celery worker concurrency — number of concurrent worker processes/threads.
# Lower it to reduce CPU/memory strain on smaller (e.g. staging) hosts. Default: 4.
CELERY_CONCURRENCY=4

# AWS (cloud posture scanning) — GreenSecOps's own IAM identity, distinct
# from the S3_* values above (which authenticate to MinIO, not AWS). This is
# the identity a customer's IAM role trusts via sts:AssumeRole. Optional:
# leave unset to disable cloud-posture scanning only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Email / SMTP
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@greensecops.example.com
# sender display name (empty → PROJECT_NAME)
EMAILS_FROM_NAME=
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# GitHub
GITHUB_ACTION_REF=greensecops/telemetry@v1
GITHUB_BOT_HANDLE=@greensecops
# GitHub App (create at https://github.com/settings/apps)
# IMPORTANT: enable "Request user authorization (OAuth) during installation" so
# the install redirect includes an OAuth `code`. The frontend exchanges it via
# POST /api/v1/installations/sync to verify + link every installation the user
# controls and queue repository sync. Reuses GITHUB_CLIENT_ID/SECRET below.
GITHUB_APP_ID=
# full PEM content
GITHUB_APP_PRIVATE_KEY=
# generate: openssl rand -hex 20
GITHUB_WEBHOOK_SECRET=
# Exposed to the frontend build as VITE_GITHUB_OAUTH_CLIENT_ID (see compose build args)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub App slug (used in install URL: github.com/apps/<slug>/installations/new)
GITHUB_APP_NAME=
# Dev only: public tunnel URL so GitHub can deliver webhooks to localhost.
# Run: ngrok http 8000  →  copy the https URL here into GREENSECOPS_PUBLIC_URL above.
# Then set GitHub App → Webhook URL → ${GREENSECOPS_PUBLIC_URL}/api/v1/webhooks/github

# Bot account for outreach PRs on EXTERNAL (open-source) repos.
# The GitHub App is not installed on arbitrary upstream repos, so fixes are
# delivered by forking the upstream into a dedicated bot account and opening a
# cross-repo PR. GITHUB_BOT_TOKEN is the bot user's GitHub App user-to-server
# OAuth token. Setup:
#   1. Give the GitHub App "Workflows: write" permission (needed to push
#      .github/workflows/* changes) and disable "Expire user authorization
#      tokens" so the token is long-lived.
#   2. Sign in as the bot account, authorize the App, and capture the resulting
#      user-to-server token here.
# GITHUB_BOT_LOGIN is the fork owner login; leave empty to derive it from the
# token automatically.
GITHUB_BOT_TOKEN=
GITHUB_BOT_LOGIN=

# AI / LLM
DEFAULT_LLM_PROVIDER=openai          # openai | anthropic | gemini | ollama
DEFAULT_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Path to JSON file defining available LLM providers and model lists.
# Mount a custom file here to change providers/models without rebuilding the image.
# Defaults to backend/app/config/ai_providers.json (bundled in the image).
AI_PROVIDERS_CONFIG=

# LangSmith (optional — enables LLM call tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=greensecops

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTIMATE=

# Observability (optional)
SENTRY_DSN=

# Landing page: contact emails shown on the marketing site
SUPPORT_EMAIL=support@greensecops.com
SALES_EMAIL=sales@greensecops.com
LEGAL_EMAIL=legal@greensecops.com
PRIVACY_EMAIL=privacy@greensecops.com
