# Domain
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="GreenSecOps"
STACK_NAME=greensecops

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173"
SECRET_KEY=                          # generate: openssl rand -hex 32
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=            # min 8 chars

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@greensecops.example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=greensecops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                   # required

# Redis
REDIS_URL=redis://localhost:6379/0

# GitHub App (create at https://github.com/settings/apps)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=              # full PEM content
GITHUB_WEBHOOK_SECRET=               # generate: openssl rand -hex 20
# Also expose GITHUB_CLIENT_ID to the frontend as VITE_GITHUB_CLIENT_ID
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# OAuth login uses a frontend popup: set the GitHub OAuth App's "Authorization
# callback URL" to this frontend route (must match the redirect_uri below).
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/auth/github/callback
# Dev only: public tunnel URL so GitHub can deliver webhooks to localhost
# Run: ngrok http 8000  →  copy the https URL here
# Then set GitHub App → Webhook URL → ${GITHUB_WEBHOOK_URL}/api/v1/webhooks/github
GITHUB_WEBHOOK_URL=

# LLM Configuration
DEFAULT_LLM_PROVIDER=openai          # openai | anthropic | gemini | ollama
DEFAULT_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# LangSmith (optional — enables LLM call tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=greensecops

# OPA
OPA_URL=http://localhost:8181

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=

# Sentry (optional)
SENTRY_DSN=

# Docker images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
