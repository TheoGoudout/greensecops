# Reproduces `try_files $uri $uri.html $uri/ =404` from landing/nginx.conf, so
# the extensionless paths the site links to keep resolving. Cloudflare Pages
# already serves /pricing from pricing.html by default, but being explicit
# means a renamed page fails loudly rather than silently 404ing.
/pricing    /pricing.html    200
/privacy    /privacy.html    200
/terms      /terms.html      200
/features   /features.html   200
/workflows  /workflows.html  200
/terraform  /terraform.html  200

# landing/nginx.conf maps any other 404 back to the home page.
/*          /index.html      404
