# Dev: what the three static surfaces are built against by Cloudflare Workers
# Builds on every push to main (deploy/cloudflare/build.sh reads this file).
# See production.env for what each value is, and staging.env for why the
# domain nests.
#
# The GitHub App has to be dev's own: its OAuth callback is the dev dashboard,
# app.dev.greensecops.com/auth/github/callback. Until GITHUB_APP_NAME and
# GITHUB_CLIENT_ID are set, the dashboard build refuses to publish — landing
# and docs, which do not use them, build regardless.

DOMAIN=dev.greensecops.com
APP_SUBDOMAIN=app
API_SUBDOMAIN=api
DOCS_SUBDOMAIN=docs

GITHUB_APP_NAME=CHANGEME
GITHUB_CLIENT_ID=CHANGEME

SUPPORT_EMAIL=support@greensecops.com
SALES_EMAIL=sales@greensecops.com
LEGAL_EMAIL=legal@greensecops.com
PRIVACY_EMAIL=privacy@greensecops.com
