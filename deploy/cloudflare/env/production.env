# Production: what the three static surfaces are built against.
#
# Read by .github/workflows/pages-reusable.yml, which derives the four public
# URLs the same way deploy/terraform/locals.tf:294 does — one domain plus three
# subdomain labels — so the AWS and Cloudflare paths describe a hostname
# identically rather than each inventing their own shape.
#
#   landing    https://${DOMAIN}
#   dashboard  https://${APP_SUBDOMAIN}.${DOMAIN}
#   API        https://${API_SUBDOMAIN}.${DOMAIN}
#   docs       https://${DOCS_SUBDOMAIN}.${DOMAIN}
#
# This file is the only source. Nothing in the workflow reads a GitHub variable
# for these values, deliberately: `vars` merges organisation, repository and
# environment scope into one namespace with no way to tell them apart, so a
# repository-scoped PUBLIC_API_URL holding the production hostname would have
# been read by the *staging* build and pointed it at the production database.
# A fork changes this file.
#
# Everything here ends up in the shipped JavaScript, so nothing in this file is
# secret. Real secrets are repository secrets; see deploy/coolify/README.md.

DOMAIN=greensecops.com
APP_SUBDOMAIN=app
API_SUBDOMAIN=api
DOCS_SUBDOMAIN=docs

# Baked into the dashboard bundle. Public — the client ID ships in the shipped
# JavaScript — but it identifies a specific App registration, and production's
# does not exist yet.
#
# CHANGEME is the repository's existing unseeded sentinel (deploy/terraform/
# ssm.tf:106) and the config job rejects it, so **a production dispatch fails
# until this is filled in**. That is the intended behaviour for an environment
# that has not been created: closed by design rather than merely unused. Push
# to main and staging still works throughout.
GITHUB_APP_NAME=greensecops
GITHUB_CLIENT_ID=CHANGEME

# Substituted into the landing pages. Identical in both environments today, but
# kept in each file so one file describes an environment completely.
SUPPORT_EMAIL=support@greensecops.com
SALES_EMAIL=sales@greensecops.com
LEGAL_EMAIL=legal@greensecops.com
PRIVACY_EMAIL=privacy@greensecops.com
