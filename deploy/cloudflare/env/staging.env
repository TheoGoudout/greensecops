# Staging: what the three static surfaces are built against on every push to
# main. See production.env for how this file is read and how to override it.
#
# The domain nests rather than flattening — app.staging.greensecops.com, not
# app-staging.greensecops.com — which keeps the derivation identical to
# production's and matches deploy/terraform/env/staging.tfvars, where
# domain_name is already "staging.greensecops.example.com".
#
# That nesting has one consequence worth knowing before you point DNS at it.
# Cloudflare's free Universal SSL covers greensecops.com and *.greensecops.com,
# one label deep — app.staging.greensecops.com is two, so it is not covered by
# that certificate. It does not matter for the three surfaces here: a Workers
# Custom Domain provisions its own per-hostname certificate at any depth. It
# matters for the API, which is not a Worker — leave api.staging's DNS record
# grey-clouded so Coolify's proxy terminates TLS with its own Let's Encrypt
# certificate, exactly as production's api. does. Proxying it instead needs
# Advanced Certificate Manager or Total TLS. See deploy/coolify/README.md.

DOMAIN=staging.greensecops.com
APP_SUBDOMAIN=app
API_SUBDOMAIN=api
DOCS_SUBDOMAIN=docs

# A GitHub App has a single webhook URL, so production's cannot also point at
# the staging API — staging needs its own App registration.
#
# Unlike production, staging has no repository variable to fall back on: set
# PUBLIC_GITHUB_CLIENT_ID on the staging GitHub Environment (which shadows the
# repository one, so staging does not silently borrow production's App), or
# seed it here. Until then the config job fails loudly rather than shipping a
# dashboard whose "Sign in with GitHub" button points nowhere.
GITHUB_APP_NAME=greensecops-staging
GITHUB_CLIENT_ID=CHANGEME

# The same addresses as production: staging is not a separate business.
SUPPORT_EMAIL=support@greensecops.com
SALES_EMAIL=sales@greensecops.com
LEGAL_EMAIL=legal@greensecops.com
PRIVACY_EMAIL=privacy@greensecops.com
