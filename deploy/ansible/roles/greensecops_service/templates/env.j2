{{ ansible_managed | comment }}
# Rendered from Parameter Store on the instance itself. Mode 0600, root-owned.
# Every key below maps to a setting in backend/app/core/config.py; .env.example
# at the repository root documents the same list with development defaults.

{% for key, value in greensecops_config.items() | sort %}
{# POSTGRES_SECRET_ARN is a pointer used by the deploy, not application config. #}
{% if key not in ['POSTGRES_SECRET_ARN', 'ANSIBLE_TRANSFER_BUCKET'] %}
{{ key }}={{ value }}
{% endif %}
{% endfor %}
{% if greensecops_needs_app_env %}

# --- secrets -----------------------------------------------------------------
{% for key, value in greensecops_secrets.items() | sort %}
{# An optional secret left at its placeholder is simply not written: an absent
   variable disables the feature cleanly, whereas "changethis" is fatal. #}
{% if value != greensecops_unseeded_placeholder %}
{{ key }}={{ value }}
{% endif %}
{% endfor %}

# Read from the RDS-managed Secrets Manager secret at deploy time, so a
# rotation is picked up by the next deploy without a configuration change.
POSTGRES_PASSWORD={{ greensecops_db_password }}

# Object storage is real S3 here rather than MinIO. Leaving the endpoint and
# the key pair unset is deliberate: boto3 then resolves the AWS endpoint and
# authenticates with the instance role (see app/services/storage/object_store.py).
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
{% endif %}
{% if greensecops_role == 'landing' %}

# The landing container substitutes these into its HTML at start-up.
APP_URL={{ greensecops_config.FRONTEND_HOST }}
{% endif %}
