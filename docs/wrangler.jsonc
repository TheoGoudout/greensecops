{
  // The Sphinx documentation as a Worker serving static assets.
  "name": "greensecops-docs",
  "compatibility_date": "2026-08-04",
  "assets": {
    // Where `sphinx-build -b html docs docs/_build/html` writes.
    "directory": "./_build/html"
  },

  // Everything above is production: `wrangler deploy` with no --env still
  // targets `greensecops-docs`, so the live Worker is unaffected by the
  // existence of this block. Staging is rebuilt rather than promoted because
  // DOCS_BASE_URL feeds html_baseurl (conf.py), which bakes the canonical
  // hostname into every page.
  "env": {
    "staging": {
      "name": "greensecops-docs-staging",
      // `assets` is repeated rather than left to environment inheritance.
      // Wrangler does inherit it, but a named environment that silently
      // resolves to no assets deploys an empty site, and this is the cheap
      // way to make `deploy --dry-run --env staging` catch that instead.
      "assets": {
        "directory": "./_build/html"
      }
    }
  }
  // No `not_found_handling`: Sphinx emits no 404.html, so the default — a
  // plain 404 for anything that is not a built page — is what we want, and
  // is what the site already does today. Sphinx's own `_static/` and
  // `_sources/` directories are served normally; only `_worker.js`,
  // `_headers` and `_redirects` are special to Workers.
}
