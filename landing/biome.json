{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**/*.{ts,tsx,js,jsx,json}",
      "features.html",
      "pricing.html",
      "privacy.html",
      "terms.html",
      "!**/node_modules/**/*",
      "!**/playwright-report/**/*",
      "!**/test-results/**/*",
      "!**/playwright.config.ts"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.html"],
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    }
  ]
}
